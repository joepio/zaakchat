  "task_templates": [
    {
      "id": "1_zaak_gestart__1_registratie",
      "title": "1 - Registratie",
      "question": "Is de aanvraag geregistreerd als nieuwe zaak?",
      "status": "1_zaak_gestart",
      "required": false,
      "description": "Direct na ontvangst van de Adviesaanvraag wordt een zaak aangemaakt voor de behandeling ervan. Idealiter is het juiste zaaktype bepaald en zijn alle voor een zaak van dat zaaktype relevant gegevens vastgelegd. Indien dat niet mogelijk is, wordt het vervolg van de registratie uitgevoerd door een medewerker die deskundig is binnen het domein waarop de zaak betrekking heeft.",
      "source_ref": {
        "file": "02_-_Advies_verstrekken_informeel_V1_9.xlsx",
        "sheet": "Checklists",
        "row": 3
      }
    },
    {
      "id": "1_zaak_gestart__2_ontvangstbevestiging",
      "title": "2 - Ontvangstbevestiging",
      "question": "Is een ontvangstbevestiging verzonden?",
      "status": "1_zaak_gestart",
      "required": false,
      "description": "Na ontvangst van een adviesaanvraag wordt een ontvangstbevestiging verzonden, waarin de dag van ontvangst van de adviesaanvraag is vermeld.",
      "source_ref": {
        "file": "02_-_Advies_verstrekken_informeel_V1_9.xlsx",
        "sheet": "Checklists",
        "row": 4
      }
    },
    {
      "id": "2_intake_afgerond__1_juiste_zaakbehandelende_organisatie",
      "title": "1 - Juiste zaakbehandelende organisatie",
      "question": "Is de zaakbehandelende organisatie bevoegd de zaak te behandelen?",
      "status": "2_intake_afgerond",
      "required": false,
      "description": "Beoordeeld wordt of de zaakbehandelende organisatie de zaak kan behandelen, hetzij omdat de zaakbehandelende organisatie daartoe bevoegd is (organisatie is bevoegd gezag of wettelijk adviseur, afdeling 3.3 Algemene wet bestuursrecht, § 2.5 Wet algemene bepalingen omgevingsrecht, art. 16.11, art. 16.15 en art 16.6 Omgevingswet, art. 10, lid b en lid c Wet veiligheidsregio's), dan wel omdat het bevoegd gezag de zaakbehandelende organisatie (bijvoorbeeld een omgevingsdienst of veiligheidsregio) heeft gemandateerd te adviseren over het onderwerp waarop de adviesaanvraag betrekking heeft. Indien de zaakbehandelende organisatie niet bevoegd of onvoldoende gemandateerd is, wordt status 3 pro forma doorlopen en bevat het adviesrapport deze constatering.",
      "source_ref": {
        "file": "02_-_Advies_verstrekken_informeel_V1_9.xlsx",
        "sheet": "Checklists",
        "row": 5
      }
    },
    {
      "id": "2_intake_afgerond__2_registratie",
      "title": "2 - Registratie",
      "question": "Zijn de gegevens compleet?",
      "status": "2_intake_afgerond",
      "required": true,
      "description": "Controleer of alle documenten en gegevens die binnen zijn gekomen ten behoeve van deze zaak, correct geregistreerd zijn in de zaak.",
      "source_ref": {
        "file": "02_-_Advies_verstrekken_informeel_V1_9.xlsx",
        "sheet": "Checklists",
        "row": 6
      }
    },
    {
      "id": "2_intake_afgerond__3_behandelaar",
      "title": "3 - Behandelaar",
      "question": "Is het behandelend team of medewerker bepaald?",
      "status": "2_intake_afgerond",
      "required": true,
      "description": "De behandelend medewerker of het behandelend organisatieonderdeel is bepaald en de zaak is volledig geregistreerd.",
      "source_ref": {
        "file": "02_-_Advies_verstrekken_informeel_V1_9.xlsx",
        "sheet": "Checklists",
        "row": 7
      }
    },
    {
      "id": "3_inhoudelijk_behandeld__1_adviezen_gevraagd",
      "title": "1 - Adviezen gevraagd",
      "question": "Zijn de voor de beoordeling relevante adviezen gevraagd?",
      "status": "3_inhoudelijk_behandeld",
      "required": false,
      "description": "Voor het toetsen van de aanvraag aan regelgeving en het zorgvuldig afwegen van belangen, kunnen adviezen van specialisten op specifieke aspecten van de adviesaanvraag noodzakelijk zijn.",
      "source_ref": {
        "file": "02_-_Advies_verstrekken_informeel_V1_9.xlsx",
        "sheet": "Checklists",
        "row": 8
      }
    },
    {
      "id": "3_inhoudelijk_behandeld__2_adviezen_ontvangen",
      "title": "2 - Adviezen ontvangen",
      "question": "Zijn de aangevraagde adviezen ontvangen en verwerkt in het adviesrapport?",
      "status": "3_inhoudelijk_behandeld",
      "required": false,
      "description": "Gecontroleerd wordt of de gevraagde specialistische adviezen zijn ontvangen. De adviezen zijn verwerkt in het concept van het adviesrapport.",
      "source_ref": {
        "file": "02_-_Advies_verstrekken_informeel_V1_9.xlsx",
        "sheet": "Checklists",
        "row": 9
      }
    },
    {
      "id": "4_zaak_afgerond__1_archivering",
      "title": "1 - Archivering",
      "question": "Is het zaakdossier compleet en archiefwaardig?",
      "status": "4_zaak_afgerond",
      "required": true,
      "description": "Gecontroleerd wordt of het zaakdossier alle relevante informatie bevat en is ontdaan van - voor de reproductie van / verantwoording over de procesgang - niet relevante informatie. Alle in het zaakdossier vastgelegde informatie is of wordt voorzien van de voor archivering vereiste metadata en is of wordt opgeslagen in een duurzaam toegankelijk (bestands)formaat.",
      "source_ref": {
        "file": "02_-_Advies_verstrekken_informeel_V1_9.xlsx",
        "sheet": "Checklists",
        "row": 10
      }
    },
    {
      "id": "4_zaak_afgerond__2_leges",
      "title": "2 - Leges",
      "question": "Is de legesbeschikking opgesteld?",
      "status": "4_zaak_afgerond",
      "required": true,
      "description": "Overheidsorganisaties kunnen voor 'verstrekte diensten' leges in rekening brengen (art. 104 Grondwet, art. 223 Provinciewet, art. 115 Waterschapswet, art. 229 Gemeentewet). De rijksoverheid bepaalt in wetgeving voor welke diensten, welke leges (tarieven) worden geheven, decentrale overheden doen dat in eigen verordeningen.\n\nOp basis van deze regelgeving wordt bepaald of een legesbeschikking moet worden opgesteld en zo ja, welk legestarief in rekening moet worden gebracht voor de behandeling van de aanvraag.",
      "source_ref": {
        "file": "02_-_Advies_verstrekken_informeel_V1_9.xlsx",
        "sheet": "Checklists",
        "row": 11
      }
    },
    {
      "id": "4_zaak_afgerond__3_verslag",
      "title": "3 - Verslag",
      "question": "Is het verslag en, indien van toepassing, de beoordeling cq. de adviesbrief verzonden?",
      "status": "4_zaak_afgerond",
      "required": true,
      "description": "",
      "source_ref": {
        "file": "02_-_Advies_verstrekken_informeel_V1_9.xlsx",
        "sheet": "Checklists",
        "row": 12
      }
    }
  ],
